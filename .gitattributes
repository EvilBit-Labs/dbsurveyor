# Golden files record byte-for-byte output, so they must not be rewritten by
# git's line-ending conversion on checkout. The renderer emits LF on every
# platform (see normalizeLineEndings in internal/report/markdown.go); this keeps
# the checked-out file agreeing with it on Windows too.
*.golden -text

# Format specifications carry a worked example in hex that a test reproduces.
docs/formats/*.md text eol=lf
docs/formats/*.json text eol=lf
