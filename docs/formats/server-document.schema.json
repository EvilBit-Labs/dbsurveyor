{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evilbitlabs.io/dbsurveyor/server-document.schema.json",
  "$ref": "#/$defs/ServerSchema",
  "$defs": {
    "CollectionMetadata": {
      "properties": {
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer"
        },
        "collector_version": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "collected_at",
        "duration_ms",
        "collector_version",
        "warnings"
      ]
    },
    "CollectionMode": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "multi_database",
            "single_database"
          ]
        },
        "discovered": {
          "type": "integer"
        },
        "collected": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "CollectionStatus": {
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "failed",
            "skipped",
            "success"
          ]
        },
        "error": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state"
      ]
    },
    "Column": {
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "$ref": "#/$defs/UnifiedDataType"
        },
        "nullable": {
          "type": "boolean"
        },
        "primary_key": {
          "type": "boolean"
        },
        "auto_generate": {
          "type": "boolean"
        },
        "default": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "ordinal_position": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "data_type",
        "nullable",
        "primary_key",
        "auto_generate",
        "ordinal_position"
      ]
    },
    "Constraint": {
      "properties": {
        "name": {
          "type": "string"
        },
        "table_name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "constraint_type": {
          "type": "string",
          "enum": [
            "check",
            "foreign_key",
            "not_null",
            "primary_key",
            "unique"
          ]
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "check_clause": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "table_name",
        "constraint_type",
        "columns"
      ]
    },
    "DatabaseInfo": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "mongodb",
            "mysql",
            "oracle",
            "postgresql",
            "sqlite",
            "sqlserver"
          ]
        },
        "version": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "encoding": {
          "type": "string"
        },
        "collation": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "system_database": {
          "type": "boolean"
        },
        "access_level": {
          "type": "string",
          "enum": [
            "full",
            "limited",
            "none"
          ]
        },
        "collection_status": {
          "$ref": "#/$defs/CollectionStatus"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type",
        "system_database",
        "access_level",
        "collection_status"
      ]
    },
    "ForeignKey": {
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "referenced_table": {
          "type": "string"
        },
        "referenced_schema": {
          "type": "string"
        },
        "referenced_columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_delete": {
          "type": "string",
          "enum": [
            "cascade",
            "no_action",
            "restrict",
            "set_default",
            "set_null"
          ]
        },
        "on_update": {
          "type": "string",
          "enum": [
            "cascade",
            "no_action",
            "restrict",
            "set_default",
            "set_null"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "columns",
        "referenced_table",
        "referenced_columns"
      ]
    },
    "Index": {
      "properties": {
        "name": {
          "type": "string"
        },
        "table_name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/IndexColumn"
          },
          "type": "array"
        },
        "unique": {
          "type": "boolean"
        },
        "primary": {
          "type": "boolean"
        },
        "index_type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "table_name",
        "columns",
        "unique",
        "primary"
      ]
    },
    "IndexColumn": {
      "properties": {
        "name": {
          "type": "string"
        },
        "sort_order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "OrderingStrategy": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "auto_increment",
            "primary_key",
            "system_row_id",
            "timestamp",
            "unordered"
          ]
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "column": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "Parameter": {
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "$ref": "#/$defs/UnifiedDataType"
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "inout",
            "out"
          ]
        },
        "default": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "data_type",
        "direction"
      ]
    },
    "PrimaryKey": {
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "columns"
      ]
    },
    "Routine": {
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "type": "array"
        },
        "return_type": {
          "$ref": "#/$defs/UnifiedDataType"
        },
        "language": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "parameters"
      ]
    },
    "SampleStatus": {
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial_retry",
            "skipped"
          ]
        },
        "original_limit": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state"
      ]
    },
    "SamplingStrategy": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "most_recent",
            "none",
            "random"
          ]
        },
        "limit": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "Schema": {
      "properties": {
        "format": {
          "type": "string"
        },
        "format_version": {
          "type": "string"
        },
        "database_info": {
          "$ref": "#/$defs/DatabaseInfo"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "type": "array"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/View"
          },
          "type": "array"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/Index"
          },
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "type": "array"
        },
        "procedures": {
          "items": {
            "$ref": "#/$defs/Routine"
          },
          "type": "array"
        },
        "functions": {
          "items": {
            "$ref": "#/$defs/Routine"
          },
          "type": "array"
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/Trigger"
          },
          "type": "array"
        },
        "user_types": {
          "items": {
            "$ref": "#/$defs/UserType"
          },
          "type": "array"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/TableSample"
          },
          "type": "array"
        },
        "collection_metadata": {
          "$ref": "#/$defs/CollectionMetadata"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "format_version",
        "database_info",
        "tables",
        "views",
        "indexes",
        "constraints",
        "procedures",
        "functions",
        "triggers",
        "user_types",
        "collection_metadata"
      ]
    },
    "ServerInfo": {
      "properties": {
        "server_type": {
          "type": "string",
          "enum": [
            "mongodb",
            "mysql",
            "oracle",
            "postgresql",
            "sqlite",
            "sqlserver"
          ]
        },
        "version": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "total_databases": {
          "type": "integer"
        },
        "collected_databases": {
          "type": "integer"
        },
        "system_databases_excluded": {
          "type": "integer"
        },
        "connection_user": {
          "type": "string"
        },
        "superuser": {
          "type": "boolean"
        },
        "collection_mode": {
          "$ref": "#/$defs/CollectionMode"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "server_type",
        "version",
        "host",
        "total_databases",
        "collected_databases",
        "system_databases_excluded",
        "connection_user",
        "superuser",
        "collection_mode"
      ]
    },
    "ServerSchema": {
      "properties": {
        "format": {
          "type": "string"
        },
        "format_version": {
          "type": "string"
        },
        "server_info": {
          "$ref": "#/$defs/ServerInfo"
        },
        "databases": {
          "items": {
            "$ref": "#/$defs/Schema"
          },
          "type": "array"
        },
        "collection_metadata": {
          "$ref": "#/$defs/CollectionMetadata"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "format_version",
        "server_info",
        "databases",
        "collection_metadata"
      ]
    },
    "Table": {
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "primary_key": {
          "$ref": "#/$defs/PrimaryKey"
        },
        "foreign_keys": {
          "items": {
            "$ref": "#/$defs/ForeignKey"
          },
          "type": "array"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/Index"
          },
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "type": "array"
        },
        "comment": {
          "type": "string"
        },
        "row_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "columns",
        "foreign_keys",
        "indexes",
        "constraints"
      ]
    },
    "TableSample": {
      "properties": {
        "table_name": {
          "type": "string"
        },
        "schema_name": {
          "type": "string"
        },
        "rows": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "sample_size": {
          "type": "integer"
        },
        "total_rows": {
          "type": "integer"
        },
        "sampling_strategy": {
          "$ref": "#/$defs/SamplingStrategy"
        },
        "ordering": {
          "$ref": "#/$defs/OrderingStrategy"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SampleStatus"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "table_name",
        "rows",
        "sample_size",
        "sampling_strategy",
        "collected_at",
        "warnings"
      ]
    },
    "Trigger": {
      "properties": {
        "name": {
          "type": "string"
        },
        "table_name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "delete",
            "insert",
            "update"
          ]
        },
        "timing": {
          "type": "string",
          "enum": [
            "after",
            "before",
            "instead_of"
          ]
        },
        "definition": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "table_name",
        "event",
        "timing"
      ]
    },
    "UnifiedDataType": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "array",
            "binary",
            "boolean",
            "custom",
            "date",
            "datetime",
            "float",
            "integer",
            "json",
            "string",
            "time",
            "uuid"
          ]
        },
        "max_length": {
          "type": "integer"
        },
        "bits": {
          "type": "integer"
        },
        "signed": {
          "type": "boolean"
        },
        "precision": {
          "type": "integer"
        },
        "with_timezone": {
          "type": "boolean"
        },
        "element_type": {
          "$ref": "#/$defs/UnifiedDataType"
        },
        "type_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "UserType": {
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "composite",
            "domain",
            "enum",
            "range"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "definition",
        "category"
      ]
    },
    "View": {
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "type": "array"
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "columns"
      ]
    }
  },
  "title": "dbsurveyor server document"
}
