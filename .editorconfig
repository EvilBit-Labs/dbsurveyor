# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust files
[*.rs]
indent_size = 4

# TOML files
[*.toml]
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false

# JSON and JSONC files. Brace expansion, not a comma list: EditorConfig
# section headers are globs, so `[*.json,*.jsonc]` matches a file literally
# named that and therefore nothing at all.
[*.{json,jsonc}]
indent_size = 2
trim_trailing_whitespace = true
indent_style = space
insert_final_newline = true

# YAML is four here, which is what the tree actually contains: every workflow,
# plus .goreleaser.yaml, .mergify.yml, codecov.yml, .coderabbit.yaml,
# dependabot.yml, and .pre-commit-config.yaml. The setting said two and had
# said it long enough that no file agreed with it. A handful of small configs
# (.golangci.yml, .yamllint.yml, ISSUE_TEMPLATE/config.yml) are still two;
# nothing enforces this, so they are left alone rather than churned.
[*.{yml,yaml}]
indent_size = 4
trim_trailing_whitespace = true
indent_style = space
insert_final_newline = true
